# ─────────────────────────────────────────────────────────────────────────────
# Streamlit Secrets — template
#
# LOCAL:  copy this file to `.streamlit/secrets.toml` and paste your key.
# CLOUD:  paste the same contents into  Settings → Secrets  on Streamlit Cloud.
#
# `.streamlit/secrets.toml` is git-ignored and must NEVER be committed.
# Only this .example file (with no real values) belongs in the repository.
# ─────────────────────────────────────────────────────────────────────────────

# Required for LLM-generated answers. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY = "sk-or-v1-REPLACE_ME"

# OPTIONAL. Leave unset to use the built-in free-model chain, which
# automatically walks past any slug that has been retired or rate-limited.
# Set this only to pin one specific model:
# OPENROUTER_MODEL = "nvidia/nemotron-3-nano-30b-a3b:free"

# OPTIONAL extra providers. Only used if OpenRouter itself is unreachable.
# GROQ_API_KEY   = "gsk_..."
# GEMINI_API_KEY = "AIza..."
